# Build output
/dist/
*.exe
*.syso

# Go
*.test
*.out

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Real certificates (personal data) — never committed. See
# testdata/certs/local/README.md.
/testdata/certs/local/*
!/testdata/certs/local/README.md

# Soft token test key material (F2 §3.3) — a private key, even a test
# one, is never committed. See testdata/softtoken/local/README.md.
/testdata/softtoken/local/*
!/testdata/softtoken/local/README.md

# Real signed PDFs (personal data in the signer certificate) — never
# committed. See testdata/pdfs/local/README.md.
/testdata/pdfs/local/*
!/testdata/pdfs/local/README.md

# TSA client-certificate test credential — never committed. See
# testdata/tsa/local/README.md.
/testdata/tsa/local/*
!/testdata/tsa/local/README.md

# Throwaway measurement harnesses (FTEST). They live inside the module so
# they can import internal/ packages, and they are deleted when the session
# that made them ends — D-100's pattern, with a guard so an accidental
# `git add -A` cannot commit one.
/local/

# Node, for the TypeScript SDK. sdk/typescript/dist IS committed — an
# integrator installs this repository straight from GitHub, so there is
# no publish step to run a build, and `npm run check-build` is what
# proves the committed output is what the source produces.
node_modules/
sdk/typescript/.dist-check/
*.tgz
